[Unit]
Description=arifOS Radar — Forge MCP UI (read-only, 127.0.0.1:7777)
Documentation=https://arifos.federation/docs/forge-mcp-ui
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/A-FORGE/forge_mcp_ui
ExecStart=/usr/bin/python3 /root/A-FORGE/forge_mcp_ui/forge_mcp_ui_start.py --port 7777 --host 127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# F1 AMANAH: no writable paths
ReadWritePaths=
# F12 INJECTION: CSP enforced at application level
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# F1 AMANAH: read-only filesystem after startup
ProtectHome=read-only
CapabilityBoundingSet=
# LOCALHOST_IS_PASSWORD: loopback only
PrivateNetwork=false
IPAddressDeny=any
IPAddressAllow=127.0.0.1

[Install]
WantedBy=multi-user.target
