{
  "name": "@ariffazil/a-forge",
  "version": "2026.06.14",
  "description": "A-FORGE — Constitutional Event-Sourced Agent Runtime. Planner/Executor/Verifier triad, policy engine, governed memory, and 888_HOLD human sovereignty gates.",
  "type": "module",
  "bin": {
    "agent": "./dist/src/interfaces/cli.js",
    "arifos-mcp": "./dist/src/interfaces/mcp/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/interfaces/server.js",
    "test": "node dist/test/AgentEngine.test.js",
    "example:explore": "node dist/examples/runExploreExample.js",
    "mcp:stdio": "node dist/src/mcp/cli.js serve --transport stdio",
    "mcp:http": "node dist/src/mcp/cli.js serve --transport http --port 3000",
    "terminal": "node dist/src/cli/terminal.js",
    "terminal:dev": "npx tsx src/cli/terminal.ts",
    "tui": "npx tsx src/infrastructure/tui/forge-tui.ts",
    "tui:start": "node dist/src/infrastructure/tui/forge-tui.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@supabase/supabase-js": "^2.108.1",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "express": "^5.1.0",
    "glob": "^13.0.6",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "pyright": "^1.1.410",
    "typescript": "^6.0.3",
    "yaml-language-server": "^1.23.0"
  }
}
