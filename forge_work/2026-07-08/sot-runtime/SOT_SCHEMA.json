{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arifos.sot/v1",
  "schema_version": "arifos.sot/v1",
  "title": "arifOS Federation SOT — Schema",
  "description": "Canonical contract for the arifOS federation Source of Truth. The schema shape is STATIC (immutable without F13 ratification). The values it validates are DYNAMIC (regenerated from live organ state by sot_publish.py).",
  "version": "1.0.0",
  "owner": "F13 SOVEREIGN (Arif)",
  "ratified": "2026-07-08",
  "invariants": {
    "organs": ["arifOS", "A-FORGE", "AAA", "GEOX", "WEALTH", "WELL", "VAULT999"],
    "canonical_floors": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "F13"],
    "tool_status_values": ["canonical", "deprecated", "experimental"],
    "organ_status_values": ["healthy", "degraded", "unreachable", "maintenance"],
    "mcp_protocol": "2025-03-26",
    "transport": "streamable-http"
  },
  "required": ["schema_version", "invariants", "dynamic_state"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "arifos.sot/v1",
      "description": "STATIC. Identifies the contract. Bump only with F13 ratification."
    },
    "invariants": {
      "type": "object",
      "description": "STATIC. The things that must not drift. Recompiled only on F13 action.",
      "required": ["organs", "canonical_floors", "mcp_protocol", "transport"],
      "properties": {
        "organs": {
          "type": "array",
          "items": {"type": "string", "enum": ["arifOS", "A-FORGE", "AAA", "GEOX", "WEALTH", "WELL", "VAULT999"]}
        },
        "canonical_floors": {
          "type": "array",
          "items": {"type": "string", "pattern": "^F[0-9]+$"}
        },
        "mcp_protocol": {"type": "string"},
        "transport": {"type": "string"}
      },
      "additionalProperties": false
    },
    "dynamic_state": {
      "type": "object",
      "description": "DYNAMIC. Regenerated by sot_publish.py from each organ's /mcp tools/list + /health.",
      "required": ["last_verified_utc", "organs"],
      "properties": {
        "last_verified_utc": {
          "type": "string",
          "format": "date-time",
          "description": "When sot_publish.py last ran."
        },
        "schema_drift": {
          "type": "array",
          "description": "Tools or organs that violate the static schema.",
          "items": {"type": "string"}
        },
        "unreachable_organs": {
          "type": "array",
          "description": "Organs whose health/list_tools probe failed.",
          "items": {"type": "string"}
        },
        "organs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["endpoint", "status", "tool_count", "canonical_count", "deprecated_count", "experimental_count", "tools"],
            "properties": {
              "endpoint": {"type": "string", "description": "STATIC. Where to probe."},
              "port": {"type": "integer"},
              "status": {"type": "string", "enum": ["healthy", "degraded", "unreachable", "maintenance"]},
              "tool_count": {"type": "integer", "minimum": 0},
              "canonical_count": {"type": "integer", "minimum": 0},
              "deprecated_count": {"type": "integer", "minimum": 0},
              "experimental_count": {"type": "integer", "minimum": 0},
              "version": {"type": "string", "description": "From /health response"},
              "identity_hash_prefix": {"type": "string", "description": "blake3 prefix, first 8 chars."},
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "status"],
                  "properties": {
                    "name": {"type": "string"},
                    "status": {"type": "string", "enum": ["canonical", "deprecated", "experimental", "unmarked"]},
                    "title": {"type": "string"},
                    "description_excerpt": {"type": "string", "maxLength": 120}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
