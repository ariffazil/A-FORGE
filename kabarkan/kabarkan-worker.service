[Unit]
Description=Kabarkan Worker — Sovereign Observability Worker
Documentation=https://arifos.arif-fazil.com
After=network-online.target postgresql.service nats-server.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/a-forge/app/kabarkan
EnvironmentFile=/root/.secrets/vault.flat.env
ExecStart=/usr/bin/python3 /opt/a-forge/app/kabarkan/worker.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Health check — worker exposes :18902
ExecStartPost=/bin/bash -c 'for i in {1..10}; do curl -sf http://127.0.0.1:18902/health && exit 0; sleep 1; done; exit 1'

# Resource limits
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
